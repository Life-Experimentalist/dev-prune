# Rust build artifacts
/target

# Node. `site/` has its own ignore file, but the repository root does not otherwise
# exclude these — and `scripts/check-mermaid.mjs` needs mermaid and jsdom installed
# here to run, so a maintainer who follows docs/ ends up with a root node_modules that
# `git add -A` would happily commit.
node_modules/
/package.json
/package-lock.json

# IDE
.idea/
.vscode/
*.swp
*.swo
temp/

# Build output. The extension is published from the release, never from the tree —
# a committed .vsix rides along with every future release as a stale extra asset.
*.vsix

# OS
.DS_Store
Thumbs.db

# Personal agent config. The dev-prune skill itself is NOT ignored: it is compiled into
# the binary with include_str!, so a clone without it does not build.
GEMINI.md
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/dev-prune/
!.agents/rules/

# dev-prune's own per-repo config, when developing against itself
.devprune.json
ignore.devprune.json

# Release archives are published as GitHub Release assets, never committed.
/releases/

# Built editor-extension artifacts. The .vsix is ignored above, with the reason.
editors/jetbrains/build/
editors/jetbrains/.gradle/
editors/jetbrains/gradle/
editors/jetbrains/gradlew*
.gstack/
