{
  "name": "dev-prune",
  "version": "1.19.0",
  "description": "Universal, lockfile-safe workspace pruner. Reclaims disk space from idle Git repositories by deleting only dependency and build directories a lockfile can rebuild.",
  "bin": {
    "dev-prune": "./bin/dev-prune.js",
    "devp": "./bin/dev-prune.js"
  },
  "files": [
    "bin",
    "README.md",
    "LICENSE.md"
  ],
  "optionalDependencies": {
    "dev-prune-darwin-arm64": "1.19.0",
    "dev-prune-darwin-x64": "1.19.0",
    "dev-prune-linux-arm64": "1.19.0",
    "dev-prune-linux-x64": "1.19.0",
    "dev-prune-windows-arm64": "1.19.0",
    "dev-prune-windows-x64": "1.19.0",
    "dev-prune-windows-x86": "1.19.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dev-prune",
    "devp",
    "cleanup",
    "prune",
    "disk-space",
    "node_modules",
    "monorepo",
    "lockfile",
    "cache",
    "npm",
    "pnpm",
    "yarn",
    "bun",
    "python",
    "venv",
    "uv",
    "poetry",
    "rust",
    "cargo",
    "go",
    "gradle",
    "maven",
    "composer",
    "bundler",
    "cocoapods",
    "swift",
    "elixir",
    "terraform",
    "flutter"
  ],
  "author": "VKrishna04",
