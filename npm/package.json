{
  "name": "dev-prune",
  "version": "1.4.0",
  "description": "Universal, lockfile-safe workspace pruner. Reclaims disk space from idle Git repositories by deleting only dependency and build directories a lockfile can rebuild.",
  "bin": {
    "dev-prune": "./bin/dev-prune.js",
    "devp": "./bin/dev-prune.js"
  },
  "files": [
    "bin",
    "README.md",
    "LICENSE.md"
  ],
  "optionalDependencies": {
    "dev-prune-darwin-arm64": "1.4.0",
    "dev-prune-darwin-x64": "1.4.0",
    "dev-prune-linux-arm64": "1.4.0",
    "dev-prune-linux-x64": "1.4.0",
    "dev-prune-win32-arm64": "1.4.0",
    "dev-prune-win32-ia32": "1.4.0",
    "dev-prune-win32-x64": "1.4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dev-prune",
    "devp",
    "cleaner",
    "disk-space",
    "node_modules",
    "venv",
    "target",
    "monorepo",
    "rust"
  ],
  "author": "VKrishna04",
  "license": "Apache-2.0",
  "homepage": "https://devprune.vkrishna04.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Life-Experimentalist/dev-prune.git"
  },
  "bugs": {
    "url": "https://github.com/Life-Experimentalist/dev-prune/issues"
  }
}
