{
	"name": "dev-prune",
	"displayName": "dev-prune",
	"description": "Validation, autocomplete and hover docs for .devprune.json — the per-repository configuration of dev-prune, the lockfile-verified workspace cleaner.",
	"version": "1.2.0",
	"publisher": "VKrishna04",
	"license": "Apache-2.0",
	"icon": "icons/devprune-128.png",
	"galleryBanner": {
		"color": "#0f172a",
		"theme": "dark"
	},
	"engines": {
		"vscode": "^1.85.0"
	},
	"main": "./extension.js",
	"activationEvents": [
		"workspaceContains:.devprune.json",
		"workspaceContains:ignore.devprune.json"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": "limited",
			"description": "Schema validation works everywhere. The check that devp is installed only runs once the workspace is trusted."
		}
	},
	"scripts": {
		"vscode:prepublish": "node sync-schema.mjs"
	},
	"categories": [
		"Linters",
		"Other"
	],
	"keywords": [
		"dev-prune",
		"devprune",
		"devp",
		"node_modules",
		"disk space",
		"cleanup",
		"json schema"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/Life-Experimentalist/dev-prune",
		"directory": "editors/vscode"
	},
	"homepage": "https://devprune.vkrishna04.me",
	"bugs": {
		"url": "https://github.com/Life-Experimentalist/dev-prune/issues"
	},
	"contributes": {
		"jsonValidation": [
			{
				"fileMatch": [
					".devprune.json",
					"**/.devprune.json"
				],
				"url": "./schemas/devprune.schema.json"
			}
		]
	}
}
