{
	"name": "dev-prune",
	"displayName": "dev-prune",
	"description": "Validation, autocomplete and hover docs for .devprune.json, plus a status bar showing reclaimable disk space — for dev-prune (devp), the lockfile-verified cleaner that reclaims disk space from node_modules, .venv, target, vendor and other rebuildable dependency folders in idle Git repositories.",
	"version": "0.4.0",
	"publisher": "VKrishna04",
	"license": "Apache-2.0",
	"icon": "icons/devprune-128.png",
	"galleryBanner": {
		"color": "#0f172a",
		"theme": "dark"
	},
	"engines": {
		"vscode": "^1.85.0"
	},
	"main": "./extension.js",
	"activationEvents": [
		"onStartupFinished"
	],
	"capabilities": {
		"virtualWorkspaces": {
			"supported": "limited",
			"description": "Schema validation for .devprune.json works everywhere. The status bar and the palette commands spawn the local devp CLI, which needs a real file system, so they stay off in virtual workspaces."
		},
		"untrustedWorkspaces": {
			"supported": "limited",
			"description": "Schema validation works everywhere. The status bar, the palette commands and the check that devp is installed only run once the workspace is trusted, because they invoke the devp CLI."
		}
	},
	"scripts": {
		"vscode:prepublish": "node sync-schema.mjs",
		"icon-font": "node build-icon-font.mjs"
	},
	"categories": [
		"Linters",
		"Other"
	],
	"keywords": [
		"dev-prune",
		"devprune",
		"devp",
		"node_modules",
		"disk space",
		"cleanup",
		"prune",
		"json schema",
		"validation",
		"lockfile",
		"npm",
		"pnpm",
		"yarn",
		"bun",
		"python",
		"venv",
		"uv",
		"rust",
		"cargo",
		"monorepo"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/Life-Experimentalist/dev-prune",
		"directory": "editors/vscode"
	},
	"homepage": "https://devprune.vkrishna04.me",
	"bugs": {
		"url": "https://github.com/Life-Experimentalist/dev-prune/issues"
	},
	"contributes": {
		"commands": [
			{
				"command": "devprune.showStatus",
				"category": "dev-prune",
				"title": "Show Reclaimable Space & Actions"
			},
			{
				"command": "devprune.dryRun",
				"category": "dev-prune",
				"title": "Dry Run in Terminal (devp run --dry-run)"
			},
			{
				"command": "devprune.installSkill",
				"category": "dev-prune",
				"title": "Install AI Agent Skill (devp skill)"
			},
			{
				"command": "devprune.openDocs",
				"category": "dev-prune",
				"title": "Open CLI Reference"
			},
			{
				"command": "devprune.refresh",
				"category": "dev-prune",
				"title": "Refresh Status Bar"
			},
			{
				"command": "devprune.gitInit",
				"category": "dev-prune",
				"title": "Initialize Git Repository (git init)"
			},
			{
				"command": "devprune.linkRepo",
				"category": "dev-prune",
				"title": "Register This Repository (devp link .)"
			},
			{
				"command": "devprune.createConfig",
				"category": "dev-prune",
				"title": "Create .devprune.json"
			},
			{
				"command": "devprune.ignoreRepo",
				"category": "dev-prune",
				"title": "Ignore This Repository (never prune)"
			}
		],
		"icons": {
			"devprune-logo": {
				"description": "The dev-prune mark, used by the status bar item.",
				"default": {
					"fontPath": "./icons/devprune.woff",
					"fontCharacter": "\\E000"
				}
			}
		},
		"jsonValidation": [
			{
				"fileMatch": [
					".devprune.json",
					"**/.devprune.json"
				],
				"url": "./schemas/devprune.schema.json"
			}
		],
		"configuration": {
			"title": "dev-prune",
			"properties": {
				"devprune.notifications": {
					"type": "boolean",
					"default": true,
					"description": "Show notification popups: the one-time install prompt when a workspace has a .devprune.json but the devp CLI is missing, and the one-time AI agent skill offer. The status bar item is not affected."
				}
			}
		}
	},
	"devDependencies": {
		"svg2ttf": "^6.0.3",
		"svgicons2svgfont": "^16.0.0",
		"ttf2woff": "^3.0.0"
	}
}
